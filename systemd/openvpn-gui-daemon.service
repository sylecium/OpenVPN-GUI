[Unit]
Description=OpenVPN GUI privileged daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/sbin/openvpn-gui-daemon
Restart=on-failure
RestartSec=2
RuntimeDirectory=openvpn-gui
# Must allow the desktop user to traverse /run/openvpn-gui and connect to the socket.
# Access control is enforced by SO_PEERCRED + allowed_uid in daemon.toml.
RuntimeDirectoryMode=0755
NoNewPrivileges=true
PrivateTmp=true
# "true" masque /home (répertoires vides) : les profils .ovpn dans $HOME semblent inexistants.
# read-only laisse lire les chemins utilisateur pour openvpn tout en interdisant l'écriture sous /home.
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/run/openvpn-gui /etc/openvpn-gui
# Sans CAP_DAC_OVERRIDE, root ne peut pas traverser les répertoires type /home/user en 700 :
# les profils sous $HOME semblent absents (exists() / open échouent).
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_SETUID CAP_SETGID CAP_DAC_OVERRIDE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_DAC_OVERRIDE

[Install]
WantedBy=multi-user.target
