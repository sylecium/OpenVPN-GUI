[Unit]
Description=OpenVPN GUI privileged daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/sbin/openvpn-gui-daemon
Restart=on-failure
RestartSec=2
# Create /run/openvpn-gui automatically at startup, world-traversable so the
# desktop user can connect to the Unix socket. Access control is enforced at
# the daemon level via SO_PEERCRED + allowed_uid in daemon.toml.
RuntimeDirectory=openvpn-gui
RuntimeDirectoryMode=0755
# Allow reading user home directories so openvpn can open .ovpn profiles.
# Without CAP_DAC_OVERRIDE, root cannot traverse 700-mode directories like
# /home/user, causing profile paths to appear missing.
ProtectHome=read-only
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_DAC_OVERRIDE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_DAC_OVERRIDE

[Install]
WantedBy=multi-user.target
