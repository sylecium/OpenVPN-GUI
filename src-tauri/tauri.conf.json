{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "openvpn-gui",
  "version": "0.1.0",
  "identifier": "com.openvpn-gui.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && cd src-tauri && cargo build --release -p openvpn-daemon",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "OpenVPN-GUI",
        "width": 1280,
        "height": 720,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "openvpn"
        ],
        "files": {
          "/usr/sbin/openvpn-gui-daemon": "target/release/openvpn-daemon",
          "/etc/systemd/system/openvpn-gui-daemon.service": "../systemd/openvpn-gui-daemon.service"
        }
      },
      "rpm": {
        "depends": [
          "openvpn"
        ],
        "files": {
          "/usr/sbin/openvpn-gui-daemon": "target/release/openvpn-daemon",
          "/etc/systemd/system/openvpn-gui-daemon.service": "../systemd/openvpn-gui-daemon.service"
        },
        "scripts": {
          "post": "../packaging/rpm/post",
          "preun": "../packaging/rpm/preun",
          "postun": "../packaging/rpm/postun"
        }
      }
    }
  }
}
