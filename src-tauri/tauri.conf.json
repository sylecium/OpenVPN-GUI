{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "openvpn-gui",
  "version": "0.2.5",
  "identifier": "openvpn-gui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && cd src-tauri && cargo build --release -p openvpn-daemon",
    "frontendDist": "../dist",
    "removeUnusedCommands": true
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "OpenVPN-GUI",
        "width": 1280,
        "height": 720,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "openvpn"
        ],
        "postInstallScript": "../packaging/debian/postinst",
        "preRemoveScript": "../packaging/debian/prerm",
        "postRemoveScript": "../packaging/debian/postrm",
        "files": {
          "/usr/sbin/openvpn-gui-daemon": "target/release/openvpn-daemon",
          "/etc/systemd/system/openvpn-gui-daemon.service": "../systemd/openvpn-gui-daemon.service"
        }
      },
      "rpm": {
        "depends": [
          "openvpn"
        ],
        "files": {
          "/usr/sbin/openvpn-gui-daemon": "target/release/openvpn-daemon",
          "/etc/systemd/system/openvpn-gui-daemon.service": "../systemd/openvpn-gui-daemon.service"
        },
        "postInstallScript": "../packaging/rpm/post",
        "preRemoveScript": "../packaging/rpm/preun",
        "postRemoveScript": "../packaging/rpm/postun"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/sylecium/OpenVPN-GUI/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFFNUU4OEVFRjFDM0ZEMApSV1RRUHh6dmp1amxDcExZT3lqeXEvRm82T1l1UEcvTlZ1UElnV1B1NXA5VEhOTXQ5V05za3pRSAo="
    }
  }
}