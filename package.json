{
  "name": "openvpn-gui",
  "private": true,
  "version": "0.2.2",
  "license": "MIT",
  "author": "sylecium",
  "description": "Tauri 2 desktop client for OpenVPN on Linux: profiles, daemon control over Unix socket, logs, session history, tun/tap traffic (instant + session totals via /proc/net/dev).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "daemon:install": "bash ./packaging/install-daemon.sh",
    "daemon:uninstall": "bash ./packaging/uninstall-daemon.sh",
    "daemon:status": "sudo systemctl status openvpn-gui-daemon.service --no-pager",
    "build:deb": "bash ./packaging/build-deb.sh",
    "build:rpm": "bash ./packaging/build-rpm.sh",
    "release": "bash ./scripts/release.sh",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@tauri-apps/cli": "^2",
    "husky": "^9.1.7",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}
